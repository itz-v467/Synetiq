COMPOSE_PROJECT_NAME=synetiq
APP_NAME=Synetiq API
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=5000
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Frontend (build-time; leave empty when using nginx same-origin on :8080)
NEXT_PUBLIC_API_URL=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/synetiq
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=./.chroma
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

WHISPER_MODEL_NAME=base
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
CELERY_EAGER=true
AUTO_CREATE_SCHEMA=true
APP_PUBLIC_URL=http://localhost:8080
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@synetiq.ai
MAX_UPLOAD_BYTES=26214400
